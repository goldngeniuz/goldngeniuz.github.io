lid #000; padding: 10px 6px; font-size: 13px; font-weight: 800; text-align: center; background-color: #fff; width: 16%;\">\n                    WEEK 2\n                  \u003c/th>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 10px 6px; font-size: 13px; font-weight: 800; text-align: center; background-color: #fff; width: 16%;\">\n                    WEEK 3\n                  \u003c/th>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 10px 6px; font-size: 13px; font-weight: 800; text-align: center; background-color: #fff; width: 16%;\">\n                    WEEK 4\n                  \u003c/th>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 10px 6px; font-size: 13px; font-weight: 800; text-align: center; background-color: #fff; width: 16%;\">\n                    WEEK 5\n                  \u003c/th>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 10px 6px; font-size: 13px; font-weight: 800; text-align: center; background-color: #fff; width: 16%;\">\n                    WEEK 6\n                  \u003c/th>\n                \n              \u003c/tr>\n              \u003ctr>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 8px 4px; font-size: 11px; font-weight: 600; text-align: center; background-color: #fff;\">\n                    14/09/26 - 18/09/26\n                  \u003c/th>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 8px 4px; font-size: 11px; font-weight: 600; text-align: center; background-color: #fff;\">\n                    21/09/26 - 25/09/26\n                  \u003c/th>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 8px 4px; font-size: 11px; font-weight: 600; text-align: center; background-color: #fff;\">\n                    28/09/26 - 02/10/26\n                  \u003c/th>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 8px 4px; font-size: 11px; font-weight: 600; text-align: center; background-color: #fff;\">\n                    05/10/26 - 09/10/26\n                  \u003c/th>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 8px 4px; font-size: 11px; font-weight: 600; text-align: center; background-color: #fff;\">\n                    12/10/26 - 16/10/26\n                  \u003c/th>\n                \n                  \u003cth style=\"border: 2px solid #000; padding: 8px 4px; font-size: 11px; font-weight: 600; text-align: center; background-color: #fff;\">\n                    19/10/26 - 23/10/26\n                  \u003c/th>\n                \n              \u003c/tr>\n            \u003c/thead>\n            \u003ctbody>\n              \u003ctr>\n                \n                  \u003ctd style=\"border: 2px solid #000; padding: 10px 8px; vertical-align: top; min-height: 280px; font-size: 11px; line-height: 1.45;\">\n                    \n                      \u003cdiv style=\"margin-bottom: 8px; padding: 4px 6px; background-color: #f8fafc;\">\n                        PHYS-A1.1: Discuss how the methodology employed by Galileo contributed to the development of Physics.\n                      \u003c/div>\n                    \n                      \u003cdiv style=\"margin-bottom: 8px; padding: 4px 6px; background-color: #f8fafc;\">\n                        PHYS-A1.2: Investigate the factors which might affect the period of a simple pendulum.\n                      \u003c/div>\n                    \n                  \u003c/td>\n                \n                  \u003ctd style=\"border: 2px solid #000; padding: 10px 8px; vertical-align: top; min-height: 280px; font-size: 11px; line-height: 1.45;\">\n                    \n                      \u003cdiv style=\"margin-bottom: 8px; padding: 4px 6px; background-color: #f8fafc;\">\n                        PHYS-A1