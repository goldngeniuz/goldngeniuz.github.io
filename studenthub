<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GREEN ISLAND HIGH SCHOOL  — Class Hub</title>
<style>
:root{
  --bg:#f5f6f8; --card:#ffffff; --text:#16181d; --muted:#6b7280;
  --accent:#2563eb; --border:#e5e7eb; --radius:14px;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#0f1115; --card:#171a21; --text:#e8eaed; --muted:#9aa1ad;
    --accent:#5b8cff; --border:#262b35;
  }
}
*{box-sizing:border-box}
body{
  margin:0; background:var(--bg); color:var(--text);
  font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
.wrap{max-width:920px;margin:0 auto;padding:0 20px}

header{padding:36px 0 24px}
header h1{margin:0;font-size:1.7rem;letter-spacing:-.02em}
header .sub{color:var(--muted);margin-top:4px}
header .meta{
  margin-top:16px;display:flex;flex-wrap:wrap;gap:8px 20px;
  font-size:.9rem;color:var(--muted)
}
header .meta a{color:var(--accent);text-decoration:none}
header .meta a:hover{text-decoration:underline}

.classbar{
  display:flex;flex-wrap:wrap;align-items:center;gap:12px;
  padding-top:18px;
}
.classbar label{font-weight:700;font-size:.85rem;color:var(--muted)}
.classbar select{
  font:inherit;font-size:.95rem;color:var(--text);background:var(--card);
  border:1px solid var(--border);border-radius:10px;padding:8px 12px;
}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{
  appearance:none;cursor:pointer;font:inherit;font-size:.8rem;font-weight:600;
  border:1px solid var(--border);background:var(--card);color:var(--muted);
  border-radius:999px;padding:6px 13px;
}
.chip:hover{color:var(--text)}
.chip.active{background:var(--accent);border-color:var(--accent);color:#fff}

nav{
  display:flex;gap:4px;border-bottom:1px solid var(--border);
  position:sticky;top:0;background:var(--bg);z-index:10;
  overflow-x:auto;margin-top:16px;
}
.tab{
  appearance:none;background:none;border:none;cursor:pointer;
  font:inherit;font-weight:600;color:var(--muted);
  padding:14px 16px;border-bottom:2px solid transparent;
  white-space:nowrap;
}
.tab:hover{color:var(--text)}
.tab.active{color:var(--accent);border-bottom-color:var(--accent)}

main{padding:28px 0 60px}
.class-heading{font-size:1.15rem;margin:0 0 14px}
.panel{display:none}
.panel.active{display:block;animation:fade .18s ease}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

.card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);padding:20px;margin-bottom:14px;
}
.card h3{margin:0 0 6px;font-size:1.05rem}
.card p{margin:0 0 8px}
.card p:last-child{margin-bottom:0}
.card .body{color:var(--text)}
.card a{color:var(--accent)}

.row{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.date{color:var(--muted);font-size:.85rem;white-space:nowrap}

.badge{
  display:inline-block;font-size:.72rem;font-weight:700;
  text-transform:uppercase;letter-spacing:.04em;
  padding:3px 9px;border-radius:999px;
}
.badge.open{background:#dcfce7;color:#166534}
.badge.soon{background:#fef3c7;color:#92400e}
.badge.closed{background:#e5e7eb;color:#4b5563}
.badge.pin{background:var(--accent);color:#fff}
@media (prefers-color-scheme: dark){
  .badge.open{background:#14321f;color:#6ee7a0}
  .badge.soon{background:#3a2c0a;color:#fbbf24}
  .badge.closed{background:#2a2f3a;color:#9aa1ad}
}

.subject-tag{
  display:inline-block;font-size:.7rem;font-weight:700;letter-spacing:.03em;
  text-transform:uppercase;color:var(--accent);
  background:rgba(37,99,235,.12);padding:3px 9px;border-radius:999px;margin-bottom:8px;
}

.empty{color:var(--muted);font-style:italic;padding:12px 0}

table{width:100%;border-collapse:collapse;font-size:.94rem}
th,td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--border);vertical-align:top}
th{font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
tbody tr:last-child td{border-bottom:none}
.scroll{overflow-x:auto;background:var(--card);border:1px solid var(--border);border-radius:var(--radius)}
td.wk{font-weight:700;color:var(--accent);white-space:nowrap}

footer{color:var(--muted);font-size:.85rem;padding:24px 0 40px;border-top:1px solid var(--border)}
</style>
</head>
<body>
<header class="wrap">
  <h1 id="schoolName"></h1>
  <div class="sub" id="schoolSub"></div>
  <div class="meta" id="schoolMeta"></div>
</header>

<div class="wrap classbar" id="classBar">
  <label for="classPicker">👋 Show work for</label>
  <select id="classPicker"></select>
  <div class="chips" id="subjectChips"></div>
</div>

<nav class="wrap" id="tabs">
  <button class="tab" data-tab="announcements">📣 Announcements</button>
  <button class="tab" data-tab="assignments">📝 Assignments</button>
  <button class="tab" data-tab="outline">📅 Course Outline</button>
</nav>

<main class="wrap">
  <h2 class="class-heading" id="classHeading"></h2>
  <section class="panel" id="announcements"></section>
  <section class="panel" id="assignments"></section>
  <section class="panel" id="outline"></section>
</main>

<footer class="wrap" id="footer"></footer>
<script>
(function renderCoursePage(CONTENT){
  const $ = s => document.querySelector(s);
  const esc = s => String(s ?? "").replace(/[&<>"]/g, c =>
    ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;" }[c]));

  const school  = CONTENT.school || {};
  const classes = Array.isArray(CONTENT.classes) ? CONTENT.classes : [];

  /* ---------- header / footer ---------- */
  document.title = (school.name || "Class") + " — Class Hub";
  $("#schoolName").textContent = school.name || "Class Hub";
  $("#schoolSub").textContent  = [school.term, school.instructor].filter(Boolean).join(" · ");
  $("#schoolMeta").innerHTML =
    (school.email
      ? '<span>✉️ <a href="mailto:' + esc(school.email) + '">' + esc(school.email) + '</a></span>'
      : "") +
    (school.officeHours ? '<span>🕑 ' + esc(school.officeHours) + '</span>' : "");
  $("#footer").innerHTML =
    [school.name, school.term].filter(Boolean).map(esc).join(" · ") +
    " · Last updated " + new Date().toLocaleDateString();

  /* ---------- small helpers ---------- */
  const prettyDate = iso => {
    if (!iso) return "TBA";
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const opts = { month: "short", day: "numeric" };
    if (String(iso).includes("T")) { opts.hour = "numeric"; opts.minute = "2-digit"; }
    return d.toLocaleDateString(undefined, opts);
  };

  const dueStatus = iso => {
    if (!iso) return { label: "Open", cls: "open" };
    const days = (new Date(iso) - new Date()) / 86400000;
    if (days < 0) return { label: "Closed",   cls: "closed" };
    if (days < 3) return { label: "Due soon", cls: "soon"   };
    return { label: "Open", cls: "open" };
  };

  /* ---------- which class is the student looking at? ---------- */
  const STORE_KEY = "classHub.selectedClass";
  const store = {
    get(k){ try { return localStorage.getItem(k); } catch (e) { return null; } },
    set(k, v){ try { localStorage.setItem(k, v); } catch (e) {} }
  };

  const picker  = $("#classPicker");
  const bar     = $("#classBar");
  const chipsEl = $("#subjectChips");
  const heading = $("#classHeading");

  let currentId = store.get(STORE_KEY);
  if (!classes.some(c => c.id === currentId)) currentId = classes.length ? classes[0].id : null;
  let subjectFilter = "all";

  const getClass = () => classes.find(c => c.id === currentId) || null;

  picker.innerHTML = classes.map(c =>
    '<option value="' + esc(c.id) + '">' + esc(c.name || "Untitled class") + "</option>").join("");
  picker.value = currentId || "";
  bar.style.display = classes.length ? "" : "none";

  const matchesSubject = item =>
    subjectFilter === "all" || !item.subject || item.subject === subjectFilter;

  /* ---------- subject chips ---------- */
  function renderChips(){
    const cls  = getClass();
    const subs = cls && Array.isArray(cls.subjects) ? cls.subjects : [];
    if (!subs.length) { chipsEl.innerHTML = ""; return; }
    chipsEl.innerHTML =
      '<button type="button" class="chip' + (subjectFilter === "all" ? " active" : "") +
        '" data-subject="all">All subjects</button>' +
      subs.map(s =>
        '<button type="button" class="chip' + (subjectFilter === s ? " active" : "") +
        '" data-subject="' + esc(s) + '">' + esc(s) + "</button>").join("");
  }

  /* ---------- announcements ---------- */
  function renderAnnouncements(){
    const host = $("#announcements");
    const cls  = getClass();
    if (!cls){
      host.innerHTML = '<p class="empty">Select a class to see its announcements.</p>';
      return;
    }
    const list = (cls.announcements || []).filter(matchesSubject).sort((a, b) => {
      if (!!a.pinned !== !!b.pinned) return a.pinned ? -1 : 1;
      return new Date(b.date || 0) - new Date(a.date || 0);
    });
    host.innerHTML = list.length ? list.map(a => `
      <article class="card">
        ${a.subject ? '<span class="subject-tag">' + esc(a.subject) + "</span>" : ""}
        <div class="row">
          <h3>${a.pinned ? '<span class="badge pin">Pinned</span> ' : ""}${esc(a.title)}</h3>
          <span class="date">${esc(prettyDate(a.date))}</span>
        </div>
        <p class="body">${a.body || ""}</p>
      </article>`).join("")
      : '<p class="empty">No announcements yet.</p>';
  }

  /* ---------- assignments ---------- */
  function renderAssignments(){
    const host = $("#assignments");
    const cls  = getClass();
    if (!cls){
      host.innerHTML = '<p class="empty">Select a class to see its assignments.</p>';
      return;
    }
    const list = (cls.assignments || []).filter(matchesSubject)
      .sort((a, b) => new Date(a.due || 0) - new Date(b.due || 0));

    host.innerHTML = list.length ? list.map(a => {
      const s = dueStatus(a.due);
      return `
      <article class="card">
        ${a.subject ? '<span class="subject-tag">' + esc(a.subject) + "</span>" : ""}
        <div class="row">
          <h3>${esc(a.title)}</h3>
          <span class="badge ${s.cls}">${s.label}</span>
        </div>
        <p class="body">${a.body || ""}</p>
        <div class="row" style="margin-top:10px">
          <span class="date">Due ${esc(prettyDate(a.due))}${a.points ? " · " + esc(a.points) + " pts" : ""}</span>
          ${a.link ? '<a href="' + esc(a.link) + '" target="_blank" rel="noopener">Open handout →</a>' : ""}
        </div>
      </article>`;
    }).join("") : '<p class="empty">No assignments posted yet.</p>';
  }

  /* ---------- outline ---------- */
  function renderOutline(){
    const host = $("#outline");
    const cls  = getClass();
    if (!cls){
      host.innerHTML = '<p class="empty">Select a class to see its outline.</p>';
      return;
    }
    const showSubject = (cls.subjects || []).length > 0;
    const list = (cls.outline || []).filter(matchesSubject)
      .sort((a, b) => (Number(a.week) || 0) - (Number(b.week) || 0));

    host.innerHTML = list.length ? `
      <div class="scroll">
        <table>
          <thead><tr>
            <th>Week</th>${showSubject ? "<th>Subject</th>" : ""}
            <th>Topic</th><th>Reading</th><th>Notes</th>
          </tr></thead>
          <tbody>${list.map(w => `
            <tr>
              <td class="wk">Week ${esc(w.week)}</td>
              ${showSubject ? "<td>" + esc(w.subject || "—") + "</td>" : ""}
              <td>${esc(w.topic)}</td>
              <td>${esc(w.reading)}</td>
              <td>${esc(w.notes)}</td>
            </tr>`).join("")}</tbody>
        </table>
      </div>` : '<p class="empty">Outline coming soon.</p>';
  }

  /* ---------- master render ---------- */
  function renderAll(){
    const cls = getClass();
    heading.textContent = cls ? (cls.name || "") : "";
    renderChips();
    renderAnnouncements();
    renderAssignments();
    renderOutline();
  }

  /* ---------- events ---------- */
  picker.addEventListener("change", () => {
    currentId = picker.value;
    subjectFilter = "all";
    store.set(STORE_KEY, currentId);
    renderAll();
  });

  chipsEl.addEventListener("click", e => {
    const b = e.target.closest("[data-subject]");
    if (!b) return;
    subjectFilter = b.dataset.subject;
    renderAll();
  });

  /* ---------- tabs ---------- */
  const ids = ["announcements", "assignments", "outline"];
  const showTab = id => {
    document.querySelectorAll(".tab").forEach(b =>
      b.classList.toggle("active", b.dataset.tab === id));
    document.querySelectorAll(".panel").forEach(p =>
      p.classList.toggle("active", p.id === id));
    try { history.replaceState(null, "", "#" + id); } catch (e) {}
  };
  document.querySelectorAll(".tab").forEach(btn =>
    btn.addEventListener("click", () => showTab(btn.dataset.tab)));
  const start = (location.hash || "").slice(1);
  showTab(ids.indexOf(start) > -1 ? start : "announcements");

  renderAll();
})({
  "school": {
    "name": "GREEN ISLAND HIGH SCHOOL ",
    "term": "Christmas Term ",
    "instructor": "Mr. Deacon ",
    "email": "al.deaconjr@gmail.com ",
    "officeHours": "Tue & Fri, 10 -11 PM · SCI LAB 1"
  },
  "classes": [
    {
      "id": "cmtz8rcrx5ecr",
      "name": "GRADE 9",
      "subjects": [
        "Physics"
      ],
      "announcements": [],
      "assignments": [],
      "outline": []
    },
    {
      "id": "cmtz8s3d17l3o",
      "name": "GRADE 10",
      "subjects": [
        "Physics"
      ],
      "announcements": [
        {
          "title": "Welcome ",
          "subject": "Physics",
          "date": "2026-09-13",
          "pinned": true,
